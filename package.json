{
  "name": "electron-webauthn-linux",
  "version": "0.1.1",
  "description": "WebAuthn/passkey support for Electron apps on Linux via passkey-rs native addon",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "native/*.node",
    "preload.js"
  ],
  "napi": {
    "binaryName": "webauthn-native",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu"
    ]
  },
  "scripts": {
    "build:rs": "napi build --platform --release --manifest-path src/native/Cargo.toml",
    "build:rs:debug": "napi build --platform --manifest-path src/native/Cargo.toml",
    "build:ts": "tsc",
    "build": "npm run build:rs && npm run build:ts",
    "dev": "tsc --watch",
    "test": "jest",
    "prepublishOnly": "npm run build",
    "artifacts": "napi artifacts"
  },
  "keywords": [
    "electron",
    "webauthn",
    "passkey",
    "fido2",
    "linux",
    "authentication"
  ],
  "author": "phelix001",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/phelix001/electron-webauthn-linux.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "electron": ">=25.0.0"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0-alpha.69",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.10.0",
    "electron": "^33.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.0"
  },
  "dependencies": {}
}
